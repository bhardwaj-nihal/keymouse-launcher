<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KeyMouseLauncher" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorSecondary">@color/accent_glow</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:windowShowWallpaper">true</item>
    </style>

    <style name="Theme.KeyMouseLauncher.Settings" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorSecondary">@color/accent_glow</item>
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
        <item name="android:windowBackground">@color/bg_main</item>
    </style>
</resources>
