<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fitsSystemWindows="true">

    <!-- Unified Top Header: Clock, Live Search ("HERE"), and Settings -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Time and Date -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="10dp">

            <TextClock
                android:id="@+id/tcClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm a"
                android:format24Hour="HH:mm"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/tcDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE, MMM d"
                android:format24Hour="EEE, d MMM"
                android:textColor="@color/accent_glow"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Search Bar integrated right HERE in the top header! -->
        <LinearLayout
            android:id="@+id/layoutSearch"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_search_input"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:contentDescription="Search Icon" />

            <EditText
                android:id="@+id/etSearchApps"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@null"
                android:src="@drawable/ic_close"
                android:contentDescription="Clear Search"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Settings Quick Button (Single clean action button) -->
        <ImageButton
            android:id="@+id/btnMainSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/item_focus_selector"
            android:src="@drawable/ic_settings"
            android:contentDescription="Settings"
            android:padding="9dp"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>

    <!-- Pinned Favorites Title -->
    <TextView
        android:id="@+id/tvFavoritesHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="8dp"
        android:text="@string/favorites_title"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Pinned Favorites Horizontal Reorderable Strip -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFavorites"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tvFavoritesHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_recent_app" />

    <!-- All Apps Section Title -->
    <TextView
        android:id="@+id/tvAllAppsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="8dp"
        android:text="@string/all_apps_title"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/rvFavorites"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Main All Apps Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAllApps"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/tvAllAppsHeader"
        app:layout_constraintBottom_toTopOf="@id/bottomDock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_app_grid" />

    <!-- Empty Apps Search Result Text -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_apps_found"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rvAllApps"
        app:layout_constraintBottom_toBottomOf="@id/rvAllApps"
        app:layout_constraintStart_toStartOf="@id/rvAllApps"
        app:layout_constraintEnd_toEndOf="@id/rvAllApps" />

    <!-- Clean Bottom Dock (Centered, contains ONLY pinned dock apps!) -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="wrap_content"
        android:layout_height="66dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_dock_glass"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Dock Pinned Apps Scrollable & Reorderable List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDockApps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipToPadding="false"
            tools:listitem="@layout/item_dock_app" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
