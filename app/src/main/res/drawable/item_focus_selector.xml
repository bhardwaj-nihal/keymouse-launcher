<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused by Keyboard Arrow Keys -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_hover" />
            <corners android:radius="14dp" />
            <stroke
                android:width="2.5dp"
                android:color="@color/border_focus" />
        </shape>
    </item>
    <!-- Pressed by Mouse or Touch -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#332563EB" />
            <corners android:radius="14dp" />
            <stroke
                android:width="2dp"
                android:color="@color/accent_light" />
        </shape>
    </item>
    <!-- Hovered by Mouse Cursor -->
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_hover" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/accent_light" />
        </shape>
    </item>
    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/border_glass" />
        </shape>
    </item>
</selector>
