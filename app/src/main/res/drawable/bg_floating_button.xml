<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#F01E293B" />
            <stroke
                android:width="2.5dp"
                android:color="@color/accent_glow" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="oval">
            <solid android:color="#E61E293B" />
            <stroke
                android:width="2dp"
                android:color="@color/accent_glow" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#E60F172A"
                android:endColor="#E61E293B"
                android:angle="45" />
            <stroke
                android:width="1.5dp"
                android:color="#8038BDF8" />
        </shape>
    </item>
</selector>
